"use strict";
var spider = document.querySelector(".spider");
document.addEventListener("click", function(e) {
    var wall = e.target.closest(".wall");
    if (!wall) return;
    var wallRect = wall.getBoundingClientRect();
    var topCoord = e.clientY - wallRect.top - wall.clientTop - spider.clientHeight / 2;
    var leftCoord = e.clientX - wallRect.left - wall.clientLeft - spider.clientWidth / 2;
    if (topCoord < 0) topCoord = 0;
    if (leftCoord < 0) leftCoord = 0;
    if (topCoord > wall.clientHeight - spider.clientHeight) topCoord = wall.clientHeight - spider.clientHeight;
    if (leftCoord > wall.clientWidth - spider.clientWidth) leftCoord = wall.clientWidth - spider.clientWidth;
    spider.style.top = topCoord + "px";
    spider.style.left = leftCoord + "px";
});

